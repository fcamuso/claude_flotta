@page "/clienti"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Logistica")]
@using FlottaGestionale.Application.Interfaces
@using FlottaGestionale.Domain.Entities
@inject IClienteService ClienteService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Clienti</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Clienti</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid Class="align-center">
        <MudItem xs="12" sm="8">
            <MudTextField T="string" Value="_searchTerm" ValueChanged="OnSearchChangedAsync" Label="Cerca per ragione sociale o partita IVA"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="300" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenDialogAsync(null)">
                Nuovo cliente
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_clienti.Count == 0)
{
    <MudText Color="Color.Secondary">Nessun cliente trovato.</MudText>
}
else
{
    <MudTable Items="_clienti" Hover="true">
        <HeaderContent>
            <MudTh>Ragione sociale</MudTh>
            <MudTh>Partita IVA</MudTh>
            <MudTh>Contatti</MudTh>
            <MudTh>Stato</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Ragione sociale">@context.RagioneSociale</MudTd>
            <MudTd DataLabel="Partita IVA">@context.PartitaIva</MudTd>
            <MudTd DataLabel="Contatti">@context.Telefono @context.Email</MudTd>
            <MudTd DataLabel="Stato">
                <MudChip T="string" Color="@(context.Attivo ? Color.Success : Color.Default)" Size="Size.Small">
                    @(context.Attivo ? "Attivo" : "Non attivo")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenDialogAsync(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<Cliente> _clienti = [];
    private bool _loading = true;
    private string _searchTerm = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _clienti = await ClienteService.GetAllAsync(_searchTerm);
        _loading = false;
    }

    private async Task OnSearchChangedAsync(string value)
    {
        _searchTerm = value;
        await LoadAsync();
    }

    private async Task OpenDialogAsync(Cliente? cliente)
    {
        var parameters = new DialogParameters<ClienteFormDialog>
        {
            { x => x.Model, cliente is null ? new Cliente() : Clone(cliente) }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ClienteFormDialog>(cliente is null ? "Nuovo cliente" : "Modifica cliente", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        try
        {
            if (cliente is null)
            {
                await ClienteService.CreateAsync((Cliente)result.Data!);
                Snackbar.Add("Cliente creato.", Severity.Success);
            }
            else
            {
                await ClienteService.UpdateAsync((Cliente)result.Data!);
                Snackbar.Add("Cliente aggiornato.", Severity.Success);
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync(Cliente cliente)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Conferma eliminazione",
            $"Eliminare il cliente {cliente.RagioneSociale}?",
            yesText: "Elimina", cancelText: "Annulla");

        if (confirm != true)
        {
            return;
        }

        try
        {
            await ClienteService.DeleteAsync(cliente.Id);
            Snackbar.Add("Cliente eliminato.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
        }
    }

    private static Cliente Clone(Cliente source) => new()
    {
        Id = source.Id,
        RagioneSociale = source.RagioneSociale,
        PartitaIva = source.PartitaIva,
        Indirizzo = source.Indirizzo,
        Telefono = source.Telefono,
        Email = source.Email,
        Attivo = source.Attivo
    };
}
