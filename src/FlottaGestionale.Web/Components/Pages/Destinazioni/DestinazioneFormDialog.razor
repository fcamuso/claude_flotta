@using FlottaGestionale.Domain.Entities

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="Model">
            <MudTextField @bind-Value="Model.Denominazione" Label="Denominazione" Required="true" RequiredError="La denominazione è obbligatoria." />
            <MudTextField @bind-Value="Model.Indirizzo" Label="Indirizzo" Required="true" RequiredError="L'indirizzo è obbligatorio." />
            <MudTextField @bind-Value="Model.Citta" Label="Città" />
            <MudTextField @bind-Value="Model.Cap" Label="CAP" MaxLength="10" />
            <MudTextField @bind-Value="Model.Provincia" Label="Provincia" MaxLength="2" />
            <MudTextField @bind-Value="Model.Note" Label="Note" Lines="2" />
            <MudSwitch @bind-Value="Model.Attivo" Label="Attivo" Color="Color.Primary" Class="mt-2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync">Salva</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Destinazione Model { get; set; } = new();

    private MudForm _form = null!;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancel() => MudDialog.Cancel();
}
