@using FlottaGestionale.Domain.Entities
@using FlottaGestionale.Infrastructure.Identity

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (!IsEdit)
            {
                <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Required="true" RequiredError="L'email è obbligatoria." />

                <MudRadioGroup T="bool" Value="_generaAutomaticamente" ValueChanged="OnModalitaChanged" Class="mt-2">
                    <MudRadio T="bool" Value="true">Genera password automaticamente</MudRadio>
                    <MudRadio T="bool" Value="false">Inserisci password manualmente</MudRadio>
                </MudRadioGroup>

                @if (!_generaAutomaticamente)
                {
                    <MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" Required="true" RequiredError="La password è obbligatoria." HelperText="Almeno 6 caratteri." />
                }

                <MudCheckBox T="bool" @bind-Value="_richiediCambioPassword" Label="Richiedi il cambio password al primo accesso" Class="mt-2" />
            }
            else
            {
                <MudTextField Value="@Email" Label="Email" ReadOnly="true" Disabled="true" />
            }

            <MudSelect T="string" @bind-Value="_ruolo" Label="Ruolo" Required="true" Class="mt-2">
                <MudSelectItem T="string" Value="@("Admin")">Amministratore</MudSelectItem>
                <MudSelectItem T="string" Value="@("Logistica")">Logistica</MudSelectItem>
                <MudSelectItem T="string" Value="@("Autista")">Autista</MudSelectItem>
            </MudSelect>

            @if (_ruolo == "Autista")
            {
                <MudSelect T="int?" @bind-Value="_autistaId" Label="Autista collegato" Clearable="true"
                          HelperText="@(Autisti.Count == 0 ? "Nessun autista disponibile da collegare." : null)">
                    @foreach (var a in Autisti)
                    {
                        <MudSelectItem T="int?" Value="@((int?)a.Id)">@a.Cognome @a.Nome</MudSelectItem>
                    }
                </MudSelect>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync">Salva</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public string Email { get; set; } = string.Empty;
    [Parameter] public string Ruolo { get; set; } = "Logistica";
    [Parameter] public int? AutistaId { get; set; }
    [Parameter] public List<Autista> Autisti { get; set; } = [];

    private MudForm _form = null!;
    private string _email = string.Empty;
    private bool _generaAutomaticamente = true;
    private string _password = string.Empty;
    private bool _richiediCambioPassword = true;
    private string _ruolo = "Logistica";
    private int? _autistaId;

    protected override void OnInitialized()
    {
        _email = Email;
        _ruolo = Ruolo;
        _autistaId = AutistaId;
    }

    private void OnModalitaChanged(bool value) => _generaAutomaticamente = value;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        var autistaId = _ruolo == "Autista" ? _autistaId : null;
        string? password = null;
        var richiediCambio = false;

        if (!IsEdit)
        {
            password = _generaAutomaticamente ? PasswordGenerator.Generate() : _password;
            richiediCambio = _richiediCambioPassword;
        }

        MudDialog.Close(DialogResult.Ok(new UtenteFormResult(_email, password, _ruolo, autistaId, richiediCambio)));
    }

    private void Cancel() => MudDialog.Cancel();

    public record UtenteFormResult(string Email, string? Password, string Ruolo, int? AutistaId, bool RichiediCambioPassword);
}
