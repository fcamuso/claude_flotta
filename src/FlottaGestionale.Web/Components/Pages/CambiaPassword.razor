@page "/cambia-password"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using FlottaGestionale.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Cambio password</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Cambio password richiesto</MudText>

<MudAlert Severity="Severity.Info" Class="mb-4">
    Per motivi di sicurezza devi impostare una nuova password prima di continuare.
</MudAlert>

<MudPaper Class="pa-4" Style="max-width: 420px">
    <MudForm @ref="_form">
        <MudTextField @bind-Value="_passwordAttuale" Label="Password attuale" InputType="InputType.Password" Required="true" RequiredError="Inserisci la password attuale." />
        <MudTextField @bind-Value="_nuovaPassword" Label="Nuova password" InputType="InputType.Password" Required="true" RequiredError="Inserisci la nuova password." HelperText="Almeno 6 caratteri." />
        <MudTextField @bind-Value="_confermaPassword" Label="Conferma nuova password" InputType="InputType.Password" Required="true" RequiredError="Conferma la nuova password." />

        @if (_errore is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errore</MudAlert>
        }

        <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SubmitAsync">
            Cambia password
        </MudButton>
    </MudForm>
</MudPaper>

@code {
    private MudForm _form = null!;
    private string _passwordAttuale = string.Empty;
    private string _nuovaPassword = string.Empty;
    private string _confermaPassword = string.Empty;
    private string? _errore;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        if (_nuovaPassword != _confermaPassword)
        {
            _errore = "Le due password non coincidono.";
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user is null)
        {
            _errore = "Utente non trovato.";
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, _passwordAttuale, _nuovaPassword);
        if (!result.Succeeded)
        {
            _errore = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        user.MustChangePassword = false;
        await UserManager.UpdateAsync(user);

        var roles = await UserManager.GetRolesAsync(user);
        var destinazione = roles.Contains("Autista") && !roles.Contains("Admin") && !roles.Contains("Logistica")
            ? "/le-mie-tratte"
            : "/";

        NavigationManager.NavigateTo(destinazione, forceLoad: true);
    }
}
